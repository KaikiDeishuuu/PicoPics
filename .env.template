# PicoPics V2 Environment Variables Template
# Copy this file to .env.local and fill in your values

# ========== GitHub OAuth (Required) ==========
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# ========== Cloudflare Workers API Endpoints ==========
NEXT_PUBLIC_UPLOAD_API=https://api.hiaplha.xyz
NEXT_PUBLIC_HISTORY_API=https://history.hiaplha.xyz
NEXT_PUBLIC_CDN_BASE=https://image.hiaplha.xyz
NEXT_PUBLIC_R2_BROWSER_API=https://r2browser.hiaplha.xyz

# ========== Admin Configuration ==========
ADMIN_TOKEN=your_admin_token_here

# ========== Cloudflare Configuration (for local development) ==========
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
DATABASE_ID=your_database_id_here
R2_BUCKET_NAME=your_bucket_name_here

# ========== Optional Settings ==========
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10485760
