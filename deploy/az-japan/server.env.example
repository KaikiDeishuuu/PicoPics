# PicoPics gateway 配置 —— 复制到 /opt/picopics/server/.env 并填写

# 对外域名（决定图片 URL、OAuth 回环、防盗链白名单）
PUBLIC_ORIGIN=https://YOUR.DOMAIN

# GitHub OAuth App（回调 URL 填 https://YOUR.DOMAIN/auth/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 管理面板令牌（X-Admin-Token），务必换成随机长字符串
ADMIN_TOKEN=

# Telegram 通知（可选，留空则不发送）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 上传限制（与 Cloudflare 生产一致的默认值）
MAX_FILE_SIZE=10485760
DAILY_QUOTA_BYTES=104857600
ABUSE_DETECTION_ENABLED=true
CONTENT_MODERATION_ENABLED=false

# 数据位置与端口（一般不动）
DATA_DIR=/var/lib/picopics
PORT=8080
