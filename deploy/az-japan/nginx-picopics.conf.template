# PicoPics nginx site — installed to /etc/nginx/sites-available/picopics.
# __DOMAIN__ is replaced by deploy/az-japan/setup-server.sh.
#
# Front-door routing (same-origin, no CORS):
#   POST /auth/callback      -> gateway :8080 (uploader OAuth exchange)
#   GET  /auth/callback      -> Next.js :3000 (the callback PAGE)
#   /upload /api/* /images/* /health -> gateway :8080
#   everything else          -> Next.js :3000
# Certificate lines are appended by `certbot --nginx` after install.

map $request_method $picopics_auth_cb_upstream {
    POST    127.0.0.1:8080;
    default 127.0.0.1:3000;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # ACME HTTP-01 challenge (Cloudflare proxies /.well-known to origin)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;
    # certbot injects ssl_certificate / ssl_certificate_key here

    # Uploads are capped at MAX_FILE_SIZE (10 MiB) — give nginx headroom.
    client_max_body_size 15m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

    location = /auth/callback {
        proxy_pass http://$picopics_auth_cb_upstream;
    }

    location = /upload {
        proxy_read_timeout 300s;
        proxy_pass http://127.0.0.1:8080;
    }

    location /api/ {
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:8080;
    }

    location /images/ {
        proxy_cache_valid 200 30d;
        proxy_pass http://127.0.0.1:8080;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
