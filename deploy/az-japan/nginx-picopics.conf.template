# PicoPics nginx site — installed to /etc/nginx/sites-available/picopics.
# __DOMAIN__ is replaced by deploy/az-japan/setup-server.sh.
#
# Ships HTTP-only; `certbot --nginx` upgrades this same server block with
# `listen 443 ssl` + certificate lines (keeping the ACME location working
# for renewals behind the Cloudflare proxy).
#
# Front-door routing (same-origin, no CORS):
#   POST /auth/callback      -> gateway :8080 (uploader OAuth exchange)
#   GET  /auth/callback      -> Next.js :3000 (the callback PAGE)
#   POST /upload             -> gateway :8080 (uploader API)
#   GET  /upload             -> Next.js :3000 (the upload PAGE)
#   /api/* /images/* /health -> gateway :8080
#   everything else          -> Next.js :3000

map $request_method $picopics_method_upstream {
    POST    127.0.0.1:8080;
    default 127.0.0.1:3000;
}

# Origin-side cache for /images/* — popular images stop hitting the Node
# gateway. This file is included inside nginx's http{} context, so declaring
# the zone here is valid.
proxy_cache_path /var/cache/nginx/picopics levels=1:2
    keys_zone=picopics_images:10m max_size=500m inactive=30d use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Baseline security headers for every response (incl. proxied APIs).
    # NOTE: nginx add_header does not inherit into locations that declare
    # their own add_header — /images/ repeats them for that reason.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ACME HTTP-01 challenge (Cloudflare proxies /.well-known to origin)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Uploads are capped at MAX_FILE_SIZE (10 MiB) — give nginx headroom.
    client_max_body_size 15m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

    location = /auth/callback {
        proxy_pass http://$picopics_method_upstream;
    }

    location = /upload {
        proxy_read_timeout 300s;
        proxy_pass http://$picopics_method_upstream;
    }

    location /api/ {
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:8080;
    }

    location /images/ {
        proxy_cache picopics_images;
        proxy_cache_key $scheme$request_method$host$request_uri;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://127.0.0.1:8080;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
